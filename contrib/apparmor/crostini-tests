# AppArmor profile for crostini integration test binaries
abi <abi/4.0>,
include <tunables/global>

# Cargo before 1.100 writes test binaries to deps/, later versions to build/<package>/<hash>/out/.
profile crostini-tests /**/target/debug/{deps/*,build/*/*/out/*} flags=(unconfined) {
  userns,

  # Site-specific additions and overrides.
  include if exists <local/crostini-tests>
}
